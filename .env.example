# ==========================================
# ms-segip: Variables de Entorno de Ejemplo
# ==========================================

# Configuración General de la Aplicación
APP_NAME=ms-segip
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Parámetros del Servicio SOAP SEGIP
# IMPORTANTE: Utilizar el hostname institucional, no IP directa.
SEGIP_SERVICE_URL=https://segip-api.fiscalia.gob.bo/ServicioExternoInstitucion.svc
SEGIP_WSDL_URL=https://segip-api.fiscalia.gob.bo/ServicioExternoInstitucion.svc?singleWsdl
SEGIP_INSTITUTION_CODE=999
SEGIP_USERNAME=usuario_institucional_ejemplo
SEGIP_PASSWORD=contrasenia_segura_ejemplo
SEGIP_CONNECT_TIMEOUT=5.0
SEGIP_READ_TIMEOUT=15.0
SEGIP_MAX_RETRIES=3
SEGIP_USUARIO_FINAL=P33638371

# Procesamiento de Documentos PDF
PDF_MAX_SIZE_MB=10.0

# Seguridad y CORS
CORS_ORIGINS=["*"]
API_KEY=

# Pruebas de Integración (dejar false por defecto)
RUN_SEGIP_INTEGRATION_TESTS=false

# ==========================================
# Base de Datos PostgreSQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=segip_user
DB_PASSWORD=segip_secret_2026
DB_NAME=segip_db
# URL para conexión asíncrona (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://segip_user:segip_secret_2026@localhost:5432/segip_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# Almacenamiento de Objetos S3 / RustFS
# ==========================================
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret2026
RUSTFS_BUCKET_NAME=segip-archivos
RUSTFS_REGION=us-east-1
RUSTFS_USE_SSL=false

